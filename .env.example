POSTGRES_PASSWORD="CHANGE_ME_LOCAL_PASSWORD"
DATABASE_URL="postgresql://elite_pack:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/elite_pack?schema=public"
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Callback OAuth : http://localhost:3000/api/auth/callback/github
# Clé fournie par TheSportsDB ; jamais exposée au navigateur.
THESPORTSDB_API_KEY=""

# development pour la clé publique 123 (local uniquement), personal pour une clé personnelle.
THESPORTSDB_MODE="development"

# Journalisation : debug, info, warn ou error (par défaut info en production, debug sinon).
LOG_LEVEL=""
# Production uniquement : exposer /api-docs et /api/openapi (désactivé par défaut).
API_DOCS_ENABLED="false"
# Production uniquement : exposer la démonstration des erreurs /demo/erreurs (désactivée par défaut).
ERROR_DEMO_ENABLED="false"
