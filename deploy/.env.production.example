# Modèle du fichier /opt/elite-pack/.env du serveur de production.
# À copier une seule fois sur le serveur (chmod 600) : il ne quitte jamais le serveur.

# Domaine public servi par Caddy (enregistrement DNS A vers l'IP du serveur).
DOMAIN="elite-pack.example.fr"

# PostgreSQL du serveur : mot de passe long et aléatoire (openssl rand -base64 32).
POSTGRES_PASSWORD="CHANGE_ME"
DATABASE_URL="postgresql://elite_pack:CHANGE_ME@postgres:5432/elite_pack?schema=public"

# Auth.js : secret propre à la production (openssl rand -base64 32), URL publique.
AUTH_SECRET="CHANGE_ME"
AUTH_URL="https://elite-pack.example.fr"

# TheSportsDB : clé personnelle obligatoire en production.
THESPORTSDB_API_KEY=""
THESPORTSDB_MODE="personal"

# Synchronisation planifiée (facultative).
CRON_SECRET=""
SYNC_ACTOR_ID=""

# Exploitation.
LOG_LEVEL="info"
API_DOCS_ENABLED="false"
ERROR_DEMO_ENABLED="false"
